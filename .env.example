# ── LLM (Anthropic Claude via T-Mobile gateway) ───────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_BASE_URL=https://llm.t-mobile.com
# The gateway is LiteLLM and routes on a provider prefix. A bare model name
# returns "no healthy deployments for this model" and every AI endpoint 500s.
ANTHROPIC_MODEL=anthropic/claude-haiku-4-5-20251001

# ── Speech / Transcription ────────────────────────────────────────────────────
# Deepgram is unreachable: the corporate proxy blocks api.deepgram.com under
# CATEGORY_DENIED (Generative AI and ML Applications). huggingface.co is blocked
# by the same rule, so local Whisper is out too. The gateway is allowlisted and
# serves whisper-1, so transcription goes through it. No separate key needed —
# it reuses ANTHROPIC_API_KEY.
TRANSCRIPTION_MODEL=openai/whisper-1

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
